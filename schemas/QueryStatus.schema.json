{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/QueryStatus",
    "definitions": {
        "PbInfluxLogger.QueryChunkInfo": {
            "required": [
                "transactionId",
                "network",
                "measurement",
                "topic",
                "chunkNumber",
                "rows",
                "sizeBytes",
                "hash",
                "format",
                "compression"
            ],
            "properties": {
                "transactionId": {
                    "type": "string"
                },
                "network": {
                    "type": "string"
                },
                "measurement": {
                    "type": "string"
                },
                "topic": {
                    "type": "string",
                    "description": "topic on which the payload was published"
                },
                "chunkNumber": {
                    "type": "integer",
                    "description": "1-based progressive in the transaction"
                },
                "rows": {
                    "type": "integer",
                    "description": "data rows, excluding the header"
                },
                "sizeBytes": {
                    "type": "integer",
                    "description": "size of the published payload"
                },
                "hash": {
                    "type": "string",
                    "description": "hexadecimal sha256 of the payload, for integrity verification"
                },
                "format": {
                    "enum": [
                        "QUERY_FORMAT_CSV",
                        0
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Query Format"
                },
                "compression": {
                    "enum": [
                        "QUERY_COMPRESSION_GZIP",
                        0,
                        "QUERY_COMPRESSION_NONE",
                        1
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Query Compression"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Query Chunk Info",
            "description": "Descriptor of a chunk published on {vehicleId}/{deviceId}/query/{transactionId}/data/content/{network}--{measurement} The payload (compressed CSV) remains the raw body of that topic: only metadata travels here."
        },
        "QueryStatus": {
            "required": [
                "transactionId",
                "timestamp",
                "state",
                "error",
                "stage",
                "description",
                "totalChunks",
                "totalRows",
                "protocolVersion",
                "chunks",
                "details"
            ],
            "properties": {
                "transactionId": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "integer",
                    "description": "epoch microseconds"
                },
                "state": {
                    "enum": [
                        "QUERY_STATE_ACCEPTED",
                        0,
                        "QUERY_STATE_RUNNING",
                        1,
                        "QUERY_STATE_COMPLETED",
                        2,
                        "QUERY_STATE_FAILED",
                        3
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Query State"
                },
                "error": {
                    "enum": [
                        "QUERY_ERROR_NONE",
                        0,
                        "QUERY_ERROR_BAD_REQUEST",
                        1,
                        "QUERY_ERROR_INVALID_RANGE",
                        2,
                        "QUERY_ERROR_NOT_AUTHORIZED",
                        3,
                        "QUERY_ERROR_UNAVAILABLE",
                        4,
                        "QUERY_ERROR_DB_UNAVAILABLE",
                        5,
                        "QUERY_ERROR_QUERY_FAILED",
                        6,
                        "QUERY_ERROR_SERIALIZATION_FAILED",
                        7,
                        "QUERY_ERROR_PUBLISH_FAILED",
                        8,
                        "QUERY_ERROR_TIMEOUT",
                        9,
                        "QUERY_ERROR_TOO_MUCH_DATA",
                        10,
                        "QUERY_ERROR_INTERNAL",
                        11
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Query Error"
                },
                "stage": {
                    "type": "string",
                    "description": "\"request\" | \"query\" | \"serialization\" | \"publish\""
                },
                "description": {
                    "type": "string",
                    "description": "human-readable message, never used for application logic"
                },
                "totalChunks": {
                    "type": "integer",
                    "description": "set on COMPLETED"
                },
                "totalRows": {
                    "type": "integer",
                    "description": "set on COMPLETED"
                },
                "protocolVersion": {
                    "type": "integer",
                    "description": "current version: 1"
                },
                "chunks": {
                    "items": {
                        "$ref": "#/definitions/PbInfluxLogger.QueryChunkInfo"
                    },
                    "additionalProperties": false,
                    "type": "array",
                    "description": "manifest sent with COMPLETED, for verification"
                },
                "details": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object",
                    "description": "future diagnostic fields, without touching the schema"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Query Status",
            "description": "Status published on {vehicleId}/{deviceId}/query/{transactionId}/status with QoS 1. Replaces topics .../data/content/eof and .../data/content/error."
        }
    }
}