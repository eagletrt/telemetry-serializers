{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/State",
    "definitions": {
        "State": {
            "required": [
                "timestamp",
                "state"
            ],
            "properties": {
                "timestamp": {
                    "type": "integer"
                },
                "state": {
                    "enum": [
                        "SERVICE_STATE_INIT",
                        0,
                        "SERVICE_STATE_IDLE",
                        1,
                        "SERVICE_STATE_RUN",
                        2,
                        "SERVICE_STATE_ERROR",
                        3,
                        "SERVICE_STATE_STOP",
                        4,
                        "SERVICE_STATE_OFFLINE",
                        5
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Service State"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "State"
        }
    }
}