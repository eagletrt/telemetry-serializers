{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/GpsDevice",
    "definitions": {
        "GpsDevice": {
            "required": [
                "address",
                "mode",
                "tcpPort",
                "enabled"
            ],
            "properties": {
                "address": {
                    "type": "string"
                },
                "mode": {
                    "type": "string"
                },
                "tcpPort": {
                    "type": "integer"
                },
                "enabled": {
                    "type": "boolean"
                },
                "speed": {
                    "type": "integer"
                },
                "port": {
                    "type": "integer"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "speed"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "port"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "speed"
                            ]
                        },
                        {
                            "required": [
                                "port"
                            ]
                        }
                    ]
                }
            ],
            "title": "Gps Device"
        }
    }
}