{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/Devices",
    "definitions": {
        "Devices": {
            "required": [
                "can",
                "gps"
            ],
            "properties": {
                "can": {
                    "items": {
                        "$ref": "#/definitions/PbConfigs.CanDevice"
                    },
                    "additionalProperties": false,
                    "type": "array"
                },
                "gps": {
                    "items": {
                        "$ref": "#/definitions/PbConfigs.GpsDevice"
                    },
                    "additionalProperties": false,
                    "type": "array"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Devices"
        },
        "PbConfigs.CanDevice": {
            "required": [
                "socket",
                "name",
                "networks"
            ],
            "properties": {
                "socket": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "networks": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Can Device"
        },
        "PbConfigs.GpsDevice": {
            "required": [
                "mode",
                "tcpPort",
                "enabled"
            ],
            "properties": {
                "path": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "mode": {
                    "type": "string"
                },
                "tcpPort": {
                    "type": "integer"
                },
                "enabled": {
                    "type": "boolean"
                },
                "speed": {
                    "type": "integer"
                },
                "port": {
                    "type": "integer"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "path"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "ip"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "path"
                            ]
                        },
                        {
                            "required": [
                                "ip"
                            ]
                        }
                    ]
                },
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "speed"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "port"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "speed"
                            ]
                        },
                        {
                            "required": [
                                "port"
                            ]
                        }
                    ]
                }
            ],
            "title": "Gps Device"
        }
    }
}