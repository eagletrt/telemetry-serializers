                        "can_send_action_send",
                        1,
                        "can_send_action_remove",
                        2,
                        "can_send_action_clear",
                        3,
                        "can_send_action_get",
                        4
                    ],
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "integer"
                        }
                    ],
