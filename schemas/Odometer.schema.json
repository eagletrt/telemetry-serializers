{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/Odometer",
    "definitions": {
        "Odometer": {
            "required": [
                "fl",
                "fr",
                "rl",
                "rr"
            ],
            "properties": {
                "fl": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
                },
                "fr": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
                },
                "rl": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
                },
                "rr": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Odometer"
        },
        "PbConfigs.Tyre": {
            "required": [
                "startDate",
                "id",
                "position",
                "kilometers"
            ],
            "properties": {
                "startDate": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
