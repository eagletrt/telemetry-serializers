                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "title": "Tyre Position"
                },
                "kilometers": {
                    "type": "number"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Tyre"
        }
    }
}