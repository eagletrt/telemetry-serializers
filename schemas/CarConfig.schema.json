                "id": {
                    "type": "string"
                },
                "kilometers": {
                    "type": "number"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Tyre"
        },
        "PbConfigs.Wheel": {
            "required": [
                "camber",
                "toe",
                "pressure"
