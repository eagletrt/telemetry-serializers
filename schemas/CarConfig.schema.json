{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/CarConfig",
    "definitions": {
        "CarConfig": {
            "required": [
                "aero",
                "wheelFront",
                "wheelRear",
                "damperFront",
                "damperRear",
                "wheelCompound",
                "rideHeight",
                "balancing",
                "notes",
                "imuCorrections",
                "odometer"
            ],
            "properties": {
                "aero": {
                    "$ref": "#/definitions/PbConfigs.Aero",
                    "additionalProperties": false
                },
                "wheelFront": {
                    "$ref": "#/definitions/PbConfigs.Wheel",
                    "additionalProperties": false
                },
                "wheelRear": {
                    "$ref": "#/definitions/PbConfigs.Wheel",
                    "additionalProperties": false
                },
                "damperFront": {
                    "$ref": "#/definitions/PbConfigs.Damper",
                    "additionalProperties": false
                },
                "damperRear": {
                    "$ref": "#/definitions/PbConfigs.Damper",
                    "additionalProperties": false
                },
                "wheelCompound": {
                    "type": "string"
                },
                "rideHeight": {
                    "type": "number"
                },
                "balancing": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "imuCorrections": {
                    "$ref": "#/definitions/PbConfigs.ImuCorrections",
                    "additionalProperties": false
