                    "additionalProperties": false
                },
                "fr": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
                },
                "rl": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
                },
                "rr": {
                    "$ref": "#/definitions/PbConfigs.Tyre",
                    "additionalProperties": false
