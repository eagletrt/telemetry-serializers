            "properties": {
                "camber": {
                    "type": "number"
                },
                "toe": {
                    "type": "number"
                },
                "pressure": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Wheel"
        }
