{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/ForwarderConfig",
    "definitions": {
        "ForwarderConfig": {
            "required": [
                "gpsDevice",
                "ntripClient",
                "mode"
            ],
            "properties": {
                "gpsDevice": {
                    "items": {
                        "$ref": "#/definitions/PbConfigs.GpsDev"
                    },
                    "additionalProperties": false,
                    "type": "array"
                },
                "ntripClient": {
                    "$ref": "#/definitions/PbConfigs.NtripClient",
                    "additionalProperties": false
                },
                "mode": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Forwarder Config"
        },
        "PbConfigs.GpsDev": {
            "required": [
                "address",
                "mode",
                "tcpPort",
                "enabled"
            ],
            "properties": {
                "address": {
                    "type": "string"
                },
                "mode": {
                    "type": "string"
                },
                "tcpPort": {
                    "type": "integer"
                },
                "enabled": {
                    "type": "boolean"
                },
                "speed": {
                    "type": "integer"
                },
                "port": {
                    "type": "integer"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "speed"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "port"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "speed"
                            ]
                        },
                        {
                            "required": [
                                "port"
                            ]
                        }
                    ]
                }
            ],
            "title": "Gps Dev"
        },
        "PbConfigs.NtripClient": {
            "required": [
                "casterHost",
                "casterPort",
                "mountPoint",
                "username",
                "password"
            ],
            "properties": {
                "casterHost": {
                    "type": "string"
                },
                "casterPort": {
                    "type": "integer"
                },
                "mountPoint": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Ntrip Client"
        }
    }
}