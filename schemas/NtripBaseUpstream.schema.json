{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/NtripBaseUpstream",
    "definitions": {
        "NtripBaseUpstream": {
            "required": [
                "casterHost",
                "casterPort",
                "mountPoint",
                "username",
                "password"
            ],
            "properties": {
                "casterHost": {
                    "type": "string"
                },
                "casterPort": {
                    "type": "integer"
                },
                "mountPoint": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Ntrip Base Upstream",
            "description": "NTRIP mountpoint the base takes corrections from: to fix itself (NTRIP_FIX) or the external antenna to serve (RELAY). Same fields as NtripClient"
        }
    }
}